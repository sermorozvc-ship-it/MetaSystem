# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prodamus (платёжная система)
# URL платёжной формы (публичный) — напр. https://metasystem.payform.ru
NEXT_PUBLIC_PRODAMUS_FORM_URL=https://metasystem.payform.ru
# Секретный ключ для проверки подписи вебхука (ЛК Prodamus → Настройки → Интеграция)
PRODAMUS_SECRET_KEY=your_prodamus_secret_key
# Тест-режим цен: true → символические тарифы 5/6/7 ₽ (питание 2 ₽) для проверки
# живой оплаты без реальных трат. Убрать/false — боевые цены.
NEXT_PUBLIC_PAYMENT_TEST_MODE=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (опционально — если оставить пустым, мониторинг отключится)
# DSN получить на https://sentry.io → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Для загрузки sourcemaps в Sentry в проде (нужно только в CI/Vercel build env)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# GitHub — синхронизация с training-brain (приватный репозиторий)
#
# Локально: создай токен на github.com и пропиши значение ниже.
#   - Fine-grained: github.com/settings/tokens?type=beta
#     Repository access: Only select repositories → training-brain
#     Permissions → Repository permissions → Contents: Read and write
#   - Или классический: github.com/settings/tokens/new, scope "repo"
#
# На Vercel: добавь GITHUB_TOKEN в Project → Settings → Environment Variables
# (Production + Preview + Development) и сделай Redeploy последнего билда.
GITHUB_TOKEN=
# Опционально: можно переопределить расположение каталога упражнений
# GITHUB_TRAINING_BRAIN_OWNER=dgmuk
# GITHUB_TRAINING_BRAIN_REPO=training-brain
# GITHUB_TRAINING_BRAIN_PATH=knowledge-base/exercises/exercise-library.md
# GITHUB_TRAINING_BRAIN_REF=main
